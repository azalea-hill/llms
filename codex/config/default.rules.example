# Commands the user always runs personally.

prefix_rule(
    pattern = ["aws"],
    decision = "forbidden",
    justification = "Do not access AWS directly. Provide the exact command for the user to run and request its output.",
)

prefix_rule(
    pattern = ["terraform"],
    decision = "forbidden",
    justification = "Do not run Terraform commands. Provide the exact command for the user to run and request its output.",
)

prefix_rule(
    pattern = ["psql"],
    decision = "forbidden",
    justification = "Do not initiate PostgreSQL connections. Provide the exact command or SQL for the user to run and request sanitized output.",
)

# Common Git operations that modify a working tree, index, refs, repository
# metadata, worktrees, or remotes.
prefix_rule(
    pattern = [
        "git",
        [
            "add",
            "am",
            "apply",
            "checkout",
            "cherry-pick",
            "clean",
            "clone",
            "commit",
            "fetch",
            "gc",
            "init",
            "maintenance",
            "merge",
            "mv",
            "pull",
            "push",
            "rebase",
            "repack",
            "reset",
            "restore",
            "revert",
            "rm",
            "stash",
            "switch",
        ],
    ],
    decision = "forbidden",
    justification = "Use Git only for read-only inspection. Ask the user to perform mutating Git operations.",
)

prefix_rule(
    pattern = [
        "git",
        "remote",
        [
            "add",
            "remove",
            "rename",
            "set-head",
            "set-branches",
            "set-url",
            "update",
            "prune",
        ],
    ],
    decision = "forbidden",
    justification = "Ask the user to perform operations that modify Git remotes or refs.",
)

prefix_rule(
    pattern = [
        "git",
        "worktree",
        ["add", "move", "remove", "prune", "repair", "lock", "unlock"],
    ],
    decision = "forbidden",
    justification = "Ask the user to perform operations that modify Git worktrees.",
)

prefix_rule(
    pattern = ["git", "reflog", ["delete", "expire"]],
    decision = "forbidden",
    justification = "Ask the user to perform operations that modify Git reflogs.",
)

prefix_rule(
    pattern = [
        "git",
        "branch",
        [
            "-d",
            "-D",
            "-m",
            "-M",
            "-c",
            "-C",
            "-f",
            "-u",
            "--delete",
            "--move",
            "--copy",
            "--force",
            "--set-upstream-to",
            "--unset-upstream",
            "--edit-description",
        ],
    ],
    decision = "forbidden",
    justification = "Use git branch only to list branches. Ask the user to create, delete, rename, or retarget branches.",
)

prefix_rule(
    pattern = [
        "git",
        "tag",
        ["-a", "-d", "-f", "-m", "-s", "-u", "-F", "--delete", "--force"],
    ],
    decision = "forbidden",
    justification = "Use git tag only to list tags. Ask the user to create or delete tags.",
)

prefix_rule(
    pattern = ["git", ["config", "update-ref", "symbolic-ref", "bisect"]],
    decision = "forbidden",
    justification = "These modify repository state or refs. Ask the user to run them; read config with cat .git/config.",
)

prefix_rule(
    pattern = [
        "git",
        "submodule",
        [
            "add",
            "init",
            "update",
            "deinit",
            "sync",
            "set-url",
            "set-branch",
            "absorbgitdirs",
            "foreach",
        ],
    ],
    decision = "forbidden",
    justification = "Use git submodule only for status. Ask the user to modify submodules.",
)

prefix_rule(
    pattern = [
        "git",
        "notes",
        ["add", "append", "copy", "edit", "merge", "prune", "remove"],
    ],
    decision = "forbidden",
    justification = "Use git notes only to list or show. Ask the user to modify notes.",
)
